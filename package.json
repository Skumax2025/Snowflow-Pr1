{
  "name": "snowflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Snowflow — радист на вышке у города, затерянного в снегах",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node src/sim/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
